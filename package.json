{
  "name": "@krisha_2512/apipulse",
  "version": "1.0.0",
  "description": "Lightweight Express.js API monitoring middleware for Node.js — tracks response times, error rates, slow requests, and endpoint analytics with zero configuration. Powered by ApiPulse.",
  "type": "module",
  "workspaces": [
    "examples/express-demo"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch --forceExit",
    "demo": "node examples/express-demo/server.js"
  },
  "keywords": [
    "api",
    "api-monitoring",
    "monitoring",
    "observability",
    "apm",
    "metrics",
    "express",
    "express-middleware",
    "middleware",
    "performance",
    "response-time",
    "latency",
    "percentile",
    "slow-api",
    "error-rate",
    "http",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
